domain_name     = "example.com"
subdomain_part  = "minecraft"

aws_region = "eu-west-2"

# manage_cloudflare_dns automates delegating the subdomain from Cloudflare.
# Off by default — domain_name can be hosted anywhere; leave this false and
# delegate manually (see README) if you're not on Cloudflare. If you are,
# uncomment all three below:
# manage_cloudflare_dns = true
# cloudflare_zone_id    = "your-cloudflare-zone-id"
#
# cloudflare_api_token is a secret. This file (once you cp it to
# terraform.tfvars) is gitignored — same as .env was in the CDK original —
# so it's fine to set it below instead of exporting an env var every shell
# session. Just double-check `git status` before committing; nothing should
# ever show terraform.tfvars as a tracked/staged file.
# cloudflare_api_token = "your-cloudflare-api-token"

sns_email_address = "you@example.com"

# Defaults (task_cpu=512, task_memory=1024, shutdown_minutes=10,
# container_insights=false) are tuned for lowest cost on a small hobby
# server. Uncomment any of these for more headroom/reliability instead:
# task_cpu            = 1024  # 1 vCPU
# task_memory         = 2048  # 2GB — Mojang's official minimum
# shutdown_minutes    = 20    # more forgiving reconnect window
# container_insights  = true  # per-metric CloudWatch cost, better visibility

# RCON (25575/tcp) is closed to the internet by default — nothing in this
# stack needs it open. Uncomment to run remote admin commands yourself (e.g.
# mcrcon) from a known IP. Never use 0.0.0.0/0 here: RCON auth is a
# plaintext password over TCP.
# rcon_allowed_cidrs = ["203.0.113.4/32"]
